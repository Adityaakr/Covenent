# Copy to .env.local (gitignored). Every value here is public: no secrets belong in the web app.

# Privy app ID (a public identifier). The owner's existing app, the same one Monaris uses as VITE_PRIVY_APP_ID.
# Leave empty to run with browser wallets only (injected connector through wagmi).
NEXT_PUBLIC_PRIVY_APP_ID=

# Origins the Privy app allows (set in the Privy dashboard). On any other origin the app starts with browser
# wallets, because Privy's iframe is blocked there. The owner's app allows http://localhost:8080 to 8085, so use
# `pnpm dev:privy` (port 8080) to test Privy locally; `pnpm dev` (port 3000) matches the server's default CORS.
NEXT_PUBLIC_PRIVY_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8085

# Wallet mode: "privy" (default when an app ID is set) or "injected" to skip Privy entirely.
NEXT_PUBLIC_WALLET_MODE=

# Base URL of the Covenant server (keeper, market data, simulator). Defaults to http://localhost:8787.
NEXT_PUBLIC_COVENANT_API=http://localhost:8787

# Local chain RPC used when contracts/deployments/local.json has no rpcUrl. Defaults to http://127.0.0.1:8545.
NEXT_PUBLIC_LOCAL_RPC=http://127.0.0.1:8545

# Offer anvil's well-known unlocked test accounts as a "Local test account" wallet on chain 31337 (1 = on).
NEXT_PUBLIC_DEV_WALLET=1

# Server-side only: where the contracts package lives, relative to web/. The loader reads
# <dir>/deployments/local.json and <dir>/abi/<Contract>.json on every request.
COVENANT_CONTRACTS_DIR=../contracts
