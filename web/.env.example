# Copy to .env.local (gitignored). Every value here is public: no secrets belong in the web app.

# Privy app ID (a public identifier). The owner's existing app, the same one Monaris uses as VITE_PRIVY_APP_ID.
# Leave empty to run with browser wallets only (injected connector through wagmi).
NEXT_PUBLIC_PRIVY_APP_ID=

# The app runs at http://localhost:8080 (`pnpm dev`, `pnpm start`), an origin the owner's Privy app allows, so Privy
# login works locally. The Covenant server must allow that origin: set CORS_ORIGINS=http://localhost:8080 in
# server/.env. `pnpm dev:3000` is an explicit alternative, but Privy's iframe is blocked there and the app starts with
# browser wallets instead.
# Origins the Privy app allows (its dashboard setting); on any other origin the app starts with browser wallets.
NEXT_PUBLIC_PRIVY_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8085

# Chain: unset (the default) serves BNB testnet from the record baked into the bundle, with no file and no server.
# A local dev chain is opt-in: 31337 (anvil) or 56 (a BNB Chain fork on NEXT_PUBLIC_LOCAL_RPC); scripts/dev-all.sh sets it.
# NEXT_PUBLIC_CHAIN_ID=

# Wallet mode: "privy" (default when an app ID is set) or "injected" to skip Privy entirely.
NEXT_PUBLIC_WALLET_MODE=

# Base URL of the Covenant server (keeper, market data, simulator). Defaults to http://localhost:8787.
NEXT_PUBLIC_COVENANT_API=http://localhost:8787

# Local chain RPC used when contracts/deployments/local.json has no rpcUrl. Defaults to http://127.0.0.1:8545.
NEXT_PUBLIC_LOCAL_RPC=http://127.0.0.1:8545

# anvil's well-known unlocked test accounts on a chain on this machine (1 = on, off by default). They are never in the
# Connect button (it opens Privy directly); a Settings screen offers them through useWalletSettings().
NEXT_PUBLIC_DEV_WALLET=0

# Server-side only: where the contracts package lives, relative to web/. The loader reads
# <dir>/deployments/local.json and <dir>/abi/<Contract>.json on every request.
COVENANT_CONTRACTS_DIR=../contracts
# Server-side only: another deployment record in the same shape, relative to web/ (default
# <COVENANT_CONTRACTS_DIR>/deployments/local.json). scripts/testnet-up.sh points it at deployments/97.local.json.
# COVENANT_DEPLOYMENTS=
