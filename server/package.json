{
  "name": "@covenant/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Covenant off-chain side: keeper, API, simulator, issuer and investor agents, MCP server",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api": "tsx src/api/main.ts",
    "keeper": "tsx src/keeper/main.ts",
    "keeper:once": "tsx src/keeper/main.ts --once",
    "sim": "tsx src/sim/main.ts",
    "issuer": "tsx agents/issuer/main.ts",
    "issuer:once": "tsx agents/issuer/main.ts --once",
    "issuer:register": "tsx agents/issuer/register.ts",
    "issuer:earn": "tsx agents/issuer/earn.ts",
    "investor": "tsx agents/investor/main.ts",
    "mcp": "tsx mcp/main.ts",
    "mcp:http": "tsx mcp/http-main.ts",
    "demo:agent": "tsx scripts/agent-demo.ts",
    "gen:llms": "tsx scripts/gen-llms.ts",
    "build:fixtures": "forge build --root test/fixtures/contracts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:chain": "vitest run --project chain"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@atlas-oracle/pull-oracle-consumer-sdk": "1.0.2",
    "@hono/node-server": "2.1.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "dotenv": "^18.0.10",
    "hono": "4.13.22",
    "viem": "2.58.6",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/ws": "^8.18.2",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vitest": "5.1.2"
  }
}
