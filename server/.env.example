# Covenant server — copy to server/.env (gitignored). Every value is optional on a local chain.
# Keys below marked "anvil" are anvil's public default test keys: never fund them anywhere real.

# --- chain -----------------------------------------------------------------
# Defaults come from contracts/deployments/local.json (chainId, rpcUrl, addresses, demo).
# RPC_URL=http://127.0.0.1:8545
# CHAIN_ID=31337
# COVENANT_DEPLOYMENTS=../contracts/deployments/local.json
# COVENANT_ABI_DIR=../contracts/abi
# Extra covenants, comma-separated vault[:launcher]
# COVENANT_VAULTS=
# COVENANT_ORACLE=
# WBNB=
# START_BLOCK=0
# CONFIRMATIONS=0
# Signing on chain 56/97 is refused unless this is set on purpose (out of scope for this build).
# COVENANT_ALLOW_PUBLIC_NETWORK=

# --- API -------------------------------------------------------------------
API_PORT=8787
# API_HOST=127.0.0.1
# Base URL written into report URIs and registration files
# API_BASE_URL=http://127.0.0.1:8787
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
COVENANT_DATA_DIR=.data

# --- Atlas (pull oracle) ---------------------------------------------------
# With a key: signed BNB/USD reports from Atlas via @atlas-oracle/pull-oracle-consumer-sdk.
# Without: the LOCAL TEST SIGNER (anvil account #9, 0xa0Ee7A142d267C1f36714E4a8F75612F20a79720)
# signs the same byte layout at ATLAS_LOCAL_BNB_USD. The local oracle must authorize that signer.
ATLAS_API_KEY=
ATLAS_BNB_USD_FEED_ID=1
# ATLAS_LOCAL_SIGNER_KEY=
ATLAS_LOCAL_BNB_USD=600

# --- CoinMarketCap DEX API (server-side only) ------------------------------
# Without a key the proxy tries the keyless /public-api prefix (rate limited) and the simulator
# uses GeckoTerminal as the stated fallback.
CMC_API_KEY=
# CMC_BASE_URL=https://pro-api.coinmarketcap.com

# --- keeper ----------------------------------------------------------------
# anvil account #5 on a local chain
KEEPER_PRIVATE_KEY=
KEEPER_TICK_SECONDS=60
# 3600 in production, 20 for the demo factory
KEEPER_POKE_INTERVAL_SECONDS=3600
KEEPER_DISPATCH_TAX=true
# keeper agent role: call declareAbandoned() when due (off by default so the demo can press it)
KEEPER_DECLARE_ABANDONED=false
# ALERT_WEBHOOK_URL=
# KEEPER_STATE_FILE=.data/keeper-state.json
# ALERTS_FILE=.data/alerts.jsonl

# --- issuer agent ----------------------------------------------------------
# The covenant's team wallet (anvil account #1 in the fixtures). Local chain only.
ISSUER_PRIVATE_KEY=
# ISSUER_VAULT=
ISSUER_TICK_SECONDS=120
# ISSUER_MIN_CLAIM_BNB=0.01
# ISSUER_HEARTBEAT_EVERY_SECONDS=604800
# ISSUER_PAY_CUT_BELOW_PREMIUM_PCT=10
# ISSUER_PERIOD_SECONDS=2592000
# ISSUER_GAS_RESERVE_BNB=0.05
# Period reports are written by Claude when this is set, otherwise by a labelled fixed template.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# ERC-8004 registries (BNB testnet: 0x8004A818BFB912233c491871b3d84c89A494BD9e / 0x8004B663056A597Dffe9eCcC1965A193B7388713)
# ERC8004_IDENTITY=
# ERC8004_REPUTATION=
# ISSUER_NAME=
# ISSUER_MCP_ENDPOINT=
# CUSTOMER_PRIVATE_KEY=

# --- investor agent --------------------------------------------------------
INVESTOR_PRIVATE_KEY=
INVESTOR_MIN_EDGE_PCT=1

# --- simulator -------------------------------------------------------------
# SIM_MAX_POOLS=80
# SIM_MIN_AGE_DAYS=14
# SIM_MAX_AGE_DAYS=180
# SIM_MIN_SAMPLE=20
# SIM_HEADLINE_RULE=decay
